{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Keinsaas Navigator",
  "colors": {
    "primary": "#6366F1",
    "light": "#8B5CF6",
    "dark": "#4F46E5"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Features",
        "groups": [
          {
            "group": "Core Tools",
            "pages": [
              "features/visual-workflows",
              "features/custom-agents",
              "features/voice-assistant",
              "features/quick-mentions",
              "features/tool-choice-mode",
              "features/default-tools"
            ]
          },
          {
            "group": "Advanced Capabilities",
            "pages": [
              "features/web-search",
              "features/js-python-executor",
              "features/data-visualization"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "guides/mcp-server-setup",
              "guides/mcp-configuration",
              "guides/system-prompts",
              "guides/chat-customization"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Support",
          "href": "mailto:support@keinsaas.com",
          "icon": "headset"
        },
        {
          "anchor": "Demo",
          "href": "https://app.keinsaas.com",
          "icon": "play"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@keinsaas.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Try Demo",
      "href": "https://app.keinsaas.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/keinsaas",
      "github": "https://github.com/keinsaas",
      "linkedin": "https://linkedin.com/company/keinsaas"
    }
  }
}
