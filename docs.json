{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "KeinSaaS Navigator",
  "colors": {
    "primary": "#2563EB",
    "light": "#14B8A6",
    "dark": "#1D4ED8"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start Here",
            "pages": [
              "index",
              "introduction",
              "quickstart",
              "installation"
            ]
          },
          {
            "group": "Run Navigator",
            "pages": [
              "configuration/environment-variables",
              "deployment/docker",
              "deployment/vercel"
            ]
          }
        ]
      },
      {
        "tab": "Features",
        "groups": [
          {
            "group": "AI Workspace",
            "pages": [
              "features/quick-mentions",
              "features/tool-choice-mode",
              "features/custom-agents",
              "features/visual-workflows",
              "features/voice-assistant"
            ]
          },
          {
            "group": "Built-in Tools",
            "pages": [
              "features/mcp-tools",
              "features/web-search",
              "features/image-generation",
              "features/code-execution",
              "features/data-visualization",
              "features/knowledge-base"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Configuration",
            "pages": [
              "guides/mcp-server-setup",
              "guides/mcp-configuration",
              "guides/system-prompts",
              "guides/chat-customization",
              "guides/file-storage",
              "guides/local-models"
            ]
          },
          {
            "group": "Project",
            "pages": [
              "reference/troubleshooting",
              "reference/contributing"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "App",
          "href": "https://app.keinsaas.com",
          "icon": "play"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@keinsaas.com",
          "icon": "headset"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@keinsaas.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.keinsaas.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/keinsaas",
      "github": "https://github.com/keinsaas",
      "linkedin": "https://linkedin.com/company/keinsaas"
    }
  }
}
